{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fishai.local/schemas/_ObservationKernel.schema.json",
  "title": "ObservationKernel",
  "description": "Shared identity, time, space, taxon, measurement, rights, and lineage fields. Synthetic/fixture use only until a wedge is locked and sources are rights-approved. Access date for conventions: 2026-09-18.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "event_id",
    "entity_type",
    "source_id",
    "source_record_id",
    "source_dataset_version",
    "source_owner",
    "ingestion_run_id",
    "observed_at_utc",
    "published_at_utc",
    "ingested_at_utc",
    "revised_at_utc",
    "spatial_cell_id",
    "h3_res",
    "privacy_tier",
    "data_rights_status",
    "raw_payload_reference",
    "transformation_version",
    "transform_hash",
    "source_checksum",
    "license"
  ],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "entity_type": {
      "type": "string",
      "enum": [
        "EnvironmentalRasterObservation",
        "InSituMeasurement",
        "SpeciesOccurrence",
        "SurveyAbundanceIndex",
        "CatchEffortObservation",
        "VesselTripObservation",
        "FarmOperationalOutcome",
        "AquacultureSensorObservation",
        "RegulatoryRestriction",
        "OfficialClosureOrAdvisory",
        "HabitatSpatialLayer",
        "MarketObservation",
        "ModelFeatureSnapshot",
        "ModelPrediction",
        "ForecastEvaluation",
        "UserFeedbackOrOutcome",
        "DataUseAgreement",
        "SourceMetadata",
        "PartnerMetadata",
        "SensitiveLocationRule"
      ]
    },
    "source_id": { "type": "string", "minLength": 1 },
    "source_record_id": { "type": "string", "minLength": 1 },
    "source_dataset_version": { "type": "string" },
    "source_owner": { "type": "string" },
    "ingestion_run_id": { "type": "string", "format": "uuid" },
    "observed_at_utc": { "type": "string", "format": "date-time" },
    "observed_at_source_local": { "type": ["string", "null"] },
    "source_timezone": { "type": ["string", "null"] },
    "published_at_utc": { "type": "string", "format": "date-time" },
    "ingested_at_utc": { "type": "string", "format": "date-time" },
    "revised_at_utc": { "type": "string", "format": "date-time" },
    "valid_from_utc": { "type": ["string", "null"], "format": "date-time" },
    "valid_to_utc": { "type": ["string", "null"], "format": "date-time" },
    "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
    "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
    "geometry": { "type": ["object", "string", "null"] },
    "geometry_precision": {
      "type": "string",
      "enum": ["exact", "rounded_0.01deg", "cell", "official_unit", "unknown"]
    },
    "geographic_uncertainty_meters": { "type": ["number", "null"], "minimum": 0 },
    "depth_meters": { "type": ["number", "null"] },
    "spatial_cell_id": { "type": "string", "minLength": 1 },
    "h3_res": { "type": "integer", "minimum": 0, "maximum": 15 },
    "spatial_cell_id_public": { "type": ["string", "null"] },
    "spatial_resolution": { "type": ["string", "null"] },
    "official_unit_id": { "type": ["string", "null"] },
    "official_unit_type": { "type": ["string", "null"] },
    "temporal_bin": { "type": ["string", "null"] },
    "species_taxon_id": { "type": ["string", "null"] },
    "scientific_name_at_source": { "type": ["string", "null"] },
    "accepted_scientific_name": { "type": ["string", "null"] },
    "taxonomic_authority": { "type": "string", "default": "WoRMS" },
    "life_stage": { "type": ["string", "null"] },
    "measurement_type": { "type": ["string", "null"] },
    "measurement_value": { "type": ["number", "null"] },
    "measurement_unit": { "type": ["string", "null"] },
    "measurement_value_native": { "type": ["string", "number", "null"] },
    "measurement_unit_native": { "type": ["string", "null"] },
    "measurement_method": { "type": ["string", "null"] },
    "sampling_effort_type": { "type": ["string", "null"] },
    "sampling_effort_value": { "type": ["number", "null"] },
    "sampling_effort_unit": { "type": ["string", "null"] },
    "detection_probability_if_known": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "observation_confidence": {
      "type": "string",
      "enum": ["high", "medium", "low", "unknown"]
    },
    "quality_flags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_tier": {
      "type": "string",
      "enum": ["T1_direct", "T2_operational", "T3_remote_or_modeled", "T4_unverified"]
    },
    "prediction_contract_category": {
      "type": ["string", "null"],
      "enum": ["A", "B", "C", "D", "E", null]
    },
    "provenance_URL": { "type": ["string", "null"] },
    "license": { "type": "string" },
    "attribution_text": { "type": ["string", "null"] },
    "privacy_tier": {
      "type": "string",
      "enum": ["PUBLIC", "COARSENED", "RESTRICTED", "PRIVATE", "NEVER_PUBLISH"]
    },
    "data_rights_status": {
      "type": "string",
      "enum": [
        "APPROVED_OPEN_COMMERCIAL",
        "APPROVED_WITH_ATTRIBUTION",
        "APPROVED_INTERNAL_ONLY",
        "APPROVED_PARTNER_CONSENT",
        "CONDITIONAL_REVIEW_REQUIRED",
        "PAID_LICENSE_REQUIRED",
        "RESEARCH_ONLY",
        "NONCOMMERCIAL_ONLY",
        "RESTRICTED",
        "REJECTED",
        "UNKNOWN"
      ]
    },
    "partner_id": { "type": ["string", "null"] },
    "data_use_agreement_id": { "type": ["string", "null"] },
    "raw_payload_reference": { "type": "string" },
    "transformation_version": { "type": "string" },
    "transform_hash": { "type": "string" },
    "source_checksum": { "type": "string" },
    "record_hash": { "type": ["string", "null"] },
    "is_retrospective_revision": { "type": "boolean", "default": false },
    "notes": { "type": ["string", "null"] }
  }
}
