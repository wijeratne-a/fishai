        },
        "species_scope": { "type": "string" },
        "geographic_scope": { "type": "string" },
        "spatial_cell_or_polygon": { "type": "string" },
        "issued_at_utc": { "type": "string", "format": "date-time" },
        "forecast_window_start_utc": { "type": "string", "format": "date-time" },
        "forecast_window_end_utc": { "type": "string", "format": "date-time" },
        "target_definition": { "type": "string" },
        "prediction_value": { "type": ["number", "string"] },
        "prediction_unit": { "type": "string" },
        "confidence_value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "confidence_category": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "uncertainty_interval": {
          "type": ["object", "null"],
          "properties": {
            "lower": { "type": "number" },
            "upper": { "type": "number" },
            "level": { "type": "number" }
          }
        },
        "model_version": { "type": "string" },
        "training_data_cutoff_utc": { "type": ["string", "null"], "format": "date-time" },
        "feature_snapshot_id": { "type": "string", "format": "uuid" },
        "source_data_cutoff_utc": { "type": "string", "format": "date-time" },
        "feature_freshness_summary": { "type": ["object", "string", "null"] },
        "known_missing_inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "user_visible_explanation": { "type": ["string", "null"] },
        "user_visible_limitations": { "type": "string" },
        "user_visible_action_options": { "type": ["string", "null"] },
        "source_attribution_bundle": { "type": ["string", "object", "null"] },
        "regulatory_context_snapshot": { "type": ["string", "object", "null"] },
        "privacy_policy_applied": { "type": "string" },
        "delivery_channel": {
          "type": ["string", "null"],
          "enum": ["email", "sms", "whatsapp", "pdf", "api", "spreadsheet", "none", null]
        },
        "delivered_at_utc": { "type": ["string", "null"], "format": "date-time" },
        "supersedes_forecast_id": { "type": ["string", "null"], "format": "uuid" },
        "is_retrospective": { "type": "boolean", "default": false },
        "prediction_contract_category": {
          "type": "string",
          "enum": ["C", "D"]
        }
      }
    }
  ],
