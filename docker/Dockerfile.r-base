FROM rocker/r-ver:4.5.2

ARG FISHAI_R_BASE_INPUT_HASH
LABEL org.opencontainers.image.source="https://github.com/wijeratne-a/fishai"
LABEL fishai.r_base.input_hash="${FISHAI_R_BASE_INPUT_HASH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    cmake \
    pkg-config \
    libabsl-dev \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    libuv1-dev \
    libudunits2-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
COPY python ./python
COPY renv ./renv
COPY renv.lock ./renv.lock
COPY .Rprofile ./.Rprofile

RUN pip3 install --no-cache-dir --break-system-packages -e ".[dev]"

RUN Rscript -e 'install.packages("renv", repos = "https://cloud.r-project.org"); source("renv/activate.R"); renv::restore(prompt = FALSE)'

ENV RENV_PATHS_LIBRARY=/app/renv/library
ENV FISHAI_ROOT=/app
