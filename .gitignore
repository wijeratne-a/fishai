# FishAI — strict ignore for data, secrets, and binary artifacts

node_modules/
dist/
.DS_Store
*.log
.env
.env.*
!.env.example
coverage/
.vite/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
*.egg-info/

# Generated WCOFS pull logs (runtime only; not committed test/dry-run rows)
data/provenance/wcofs_pull_log.jsonl
data/provenance/wcofs_pull_*.jsonl

# Data trees (never commit raw/processed survey or grid files)
data/raw/
data/processed/
data/cache/
data/interim/
data/restricted/
data/quarantine/*
!data/quarantine/README.md

# Secrets and credentials
credentials/
secrets/
*.pem
*.key

# Geospatial and model binaries
*.nc
*.grib
*.grib2
*.parquet
*.zarr
*.zarr/
*.h5
*.hdf5
*.gpkg
*.tif
*.tiff
*.pdf

# R renv library (lockfile is tracked)
renv/library/
renv/local/
renv/cellar/
renv/staging/

# Generated by src/models/tests/testthat/setup.R
src/models/tests/fixtures/synthetic_land_barrier.rds

