{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fishai.local/schemas/event.schema.json",
  "title": "Event",
  "description": "Protocol sample unit / survey event. Missing species rows are not absences unless a verified non-detection rule applies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "source_id",
    "protocol_id",
    "observed_at_utc",
    "time_precision",
    "spatial_support",
    "privacy_tier"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_record_id": {
      "type": ["string", "null"]
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1,
      "description": "Must match the source protocol; do not pool incompatible protocols."
    },
    "parent_event_id": {
      "type": ["string", "null"]
    },
    "observed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at_source_local": {
      "type": ["string", "null"]
    },
    "source_timezone": {
      "type": ["string", "null"]
    },
    "time_precision": {
      "$ref": "#/definitions/time_precision"
    },
    "valid_from_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "valid_to_utc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "spatial_support": {
      "type": "string",
      "enum": [
        "POINT",
        "TRANSECT",
        "TOW",
        "SAMPLE_UNIT",
        "POLYGON",
        "CELL",
        "OFFICIAL_UNIT",
        "UNKNOWN"
      ]
    },
    "latitude": {
      "type": ["number", "null"],
      "minimum": -90,
      "maximum": 90,
      "description": "Native coordinate for private/internal storage only. Null on public/globe rows."
    },
    "longitude": {
      "type": ["number", "null"],
      "minimum": -180,
      "maximum": 180
    },
    "spatial_cell_id": {
      "type": ["string", "null"]
    },
    "h3_res": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 15
    },
    "depth_meters": {
      "type": ["number", "null"],
      "description": "Positive downward from sea surface when known."
    },
    "depth_unknown": {
      "type": "boolean",
      "default": false
    },
    "habitat_or_stratum": {
      "type": ["string", "null"]
    },
    "effort_id": {
      "type": ["string", "null"],
      "description": "Link to effort when the protocol completed a search unit."
    },
    "privacy_tier": {
      "type": "string",
      "enum": [
        "PUBLIC",
        "COARSENED",
        "RESTRICTED",
        "PRIVATE",
        "NEVER_PUBLISH"
      ]
    },
    "provenance_id": {
      "type": ["string", "null"]
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "definitions": {
    "time_precision": {
      "type": "string",
      "enum": [
        "SECOND",
        "MINUTE",
        "HOUR",
        "DAY",
        "MONTH",
        "YEAR",
        "UNKNOWN"
      ],
      "description": "Explicit temporal grain of observed_at_utc. Required; do not imply finer precision than the source."
    }
  }
}
